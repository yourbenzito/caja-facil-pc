# CONFIGURACIÓN DEL SERVIDOR CAJAFÁCIL POS
# ================================================
# AMBIENTE: development = tu PC | production = VPS real
# ================================================
NODE_ENV=development
PORT=3000

# JWT para seguridad de sesiones (generado automáticamente por setup-env.js)
JWT_SECRET=37ed0052359cf3af649751e2899c3950767d2de46e507aeaa3734d6434a0f0412857579f0611e6c4c8791f266c65f35ed9ac4efad8465e89dce065406b51d644

# GATEWAY SECURITY LOCK (generado automáticamente por setup-env.js)
GATEWAY_PASSWORD=qcnnK@KEtgxyDTVEmknZScWc5fuLiiqI

# ACTUALIZACIONES AUTOMÁTICAS
# URL donde se encuentra el archivo version.json con información de actualizaciones
# Ejemplo: https://tudominio.com/updates
# Dejar vacío para desactivar actualizaciones automáticas
UPDATE_URL=

# BASE DE DATOS LOCAL
# En development: usa ./data-dev (datos de prueba, separados de producción)
# En production: usa ./data (datos reales de clientes)
DATA_DIR=./data

# SUPER ADMIN: Tu usuario "Master" que ignora límites de suscripción
# Pon aquí el username exacto con el que te logueas
SUPER_ADMIN_USERNAME=admin

# APP CONFIG
APP_URL=http://localhost:3000

# MERCADOPAGO CONFIGURACIÓN
# Obtén estas credenciales en: https://www.mercadopago.cl/developers
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_APP_ID=
MERCADOPAGO_DEVICE_ID=
