{
  "name": "caja-facil-pos",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta POS con Sincronización Cloud y Móvil",
  "author": "Caja Fácil",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node --max-old-space-size=4096 backend/server.js",
    "app": "npx electron .",
    "build": "electron-builder",
    "setup": "node backend/setup-env.js",
    "postinstall": "node backend/setup-env.js"
  },
  "build": {
    "appId": "com.cajafacil.pos",
    "productName": "Caja Fácil POS",
    "icon": "icons/icon.png",
    "asarUnpack": [
      "node_modules/sqlite3/**",
      "backend/server.js",
      "backend/schema.sql",
      "backend/data/database.sqlite"
    ],
    "files": [
      "**/*",
      "!backend/.env",
      "!**/*.log",
      "!**/node_modules/.cache/**",
      "!**/*.pem",
      "!**/*.key",
      "!admin_tools/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.0.0",
    "sqlite3": "^6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.1/xlsx-0.20.1.tgz"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0"
  }
}
